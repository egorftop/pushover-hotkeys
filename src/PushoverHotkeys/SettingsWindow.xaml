<Window x:Class="PushoverHotkeys.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Icon="Assets/app-icon.ico"
        Width="520"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pushover App Token" FontWeight="SemiBold" />
            <PasswordBox x:Name="AppTokenBox" Margin="0,3,0,4" />
            <TextBlock Foreground="DimGray" TextWrapping="Wrap"
                       Text="Токен приложения Pushover из панели разработчика. Он хранится локально в зашифрованном виде." />
        </StackPanel>

        <CheckBox x:Name="AutostartCheckBox"
                  Grid.Row="1"
                  Margin="0,18,0,0"
                  Content="Запускать вместе с Windows в системном трее" />

        <TextBlock Grid.Row="2" Margin="0,18,0,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="Приложение не блокирует нажатия. Системные, аппаратные клавиши и некоторые программы с повышенными правами могут не передавать их Windows." />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" />
            <Button Content="Отмена" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
